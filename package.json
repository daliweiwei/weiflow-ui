  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "build:lib": "vue-cli-service build --target lib --name weiflow-ui packages/index.js",
    "lint": "vue-cli-service lint",
    "prepublishOnly": "npm run build:lib"
  },
  "homepage": "https://github.com/daliweiwei/weiflow-ui#readme",

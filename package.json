    "url": "git+https://github.com/daliweiwei/weiflow-ui.git"
  },
  "license": "MIT",
  "author": {
    "name": "liweiliang",
    "email": "406320591@qq.com"
  },
  "peerDependencies": {
    "vue": ">=2.6.0 <3.0.0",
    "element-ui": ">=2.15.0 <3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "core-js": "^3.8.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "prettier": "^3.2.0",
    "sass": "^1.69.7",
    "sass-loader": "^14.2.1",
    "vue": "^2.7.16",
    "element-ui": "^2.15.14",
    "vue-template-compiler": "^2.7.16"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
